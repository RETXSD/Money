rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(d) {
      return d.keys().hasAll(['displayName', 'gender', 'birthDate'])
        && d.displayName is string
        && d.displayName.size() >= 1
        && d.displayName.size() <= 50
        && d.gender in ['female', 'male']
        && d.birthDate is string
        && d.birthDate.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validTransaction(d) {
      return d.amount is int && d.amount > 0
        && d.type in ['income', 'expense']
        && d.date is timestamp
        && d.get('source', '') in ['manual', 'quick-add']
        && (d.get('debtId', null) is string || d.get('debtId', null) == null);
    }

    function transactionMetadataIsValid(d) {
      return d.get('fixedBillId', null) is string || d.get('fixedBillId', null) == null;
    }

    function validDebt(d) {
      return d.amount is int && d.amount > 0
        && d.paidAmount is int && d.paidAmount >= 0 && d.paidAmount <= d.amount
        && d.direction in ['owed_to_me', 'i_owe']
        && d.status in ['open', 'settled']
        && d.get('affectsCash', true) is bool
        && (d.dueDate is timestamp || d.dueDate == null);
    }

    function validPayment(d) {
      return d.amount is int && d.amount > 0
        && d.paidAt is timestamp
        && d.get('note', '') is string;
    }

    function validBudget(d) {
      return d.limit is int && d.limit > 0;
    }

    function validFixedBill(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.amount is int && d.amount > 0
        && d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31
        && d.active is bool
        && (d.paidCycleKey is string || d.paidCycleKey == null);
    }

    function validPerson(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 50
        && (d.phone is string || d.phone == null);
    }

    function validBudgetSettings(d) {
      return d.paydayDay is int && d.paydayDay >= 1 && d.paydayDay <= 31
        && d.balanceBase is int
        && d.balanceBaseDate is timestamp;
    }

    function validAccountSettings(d) {
      return d.plan in ['free', 'pro'];
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /transactions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validTransaction(request.resource.data)
          && transactionMetadataIsValid(request.resource.data);
      }

      match /debts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDebt(request.resource.data);

        match /payments/{paymentId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validPayment(request.resource.data);
        }
      }

      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.type in ['expense', 'income']
          && request.resource.data.icon is string
          && request.resource.data.keywords is list;
      }

      match /budgets/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBudget(request.resource.data);
      }

      match /fixedBills/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFixedBill(request.resource.data);
      }

      match /people/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPerson(request.resource.data);
      }

      match /settings/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ((id == 'budget' && validBudgetSettings(request.resource.data))
            || (id == 'account' && validAccountSettings(request.resource.data)));
      }
    }

    function validNotificationSlot(slot) {
      return slot is map
        && slot.keys().hasAll(['enabled', 'hour'])
        && slot.keys().hasOnly(['enabled', 'hour'])
        && slot.enabled is bool
        && slot.hour is int
        && slot.hour >= 0
        && slot.hour <= 23;
    }

    function validNotificationSubscription(d) {
      return d.enabled is bool
        && d.hideAmounts is bool
        && d.timezone is string
        && d.timezone.size() >= 1
        && d.timezone.size() <= 80
        && d.slots is map
        && d.slots.keys().hasAll(['morning', 'noon', 'evening'])
        && d.slots.keys().hasOnly(['morning', 'noon', 'evening'])
        && validNotificationSlot(d.slots.morning)
        && validNotificationSlot(d.slots.noon)
        && validNotificationSlot(d.slots.evening)
        && d.fcmTokens is list
        && d.fcmTokens.size() <= 5
        && d.updatedAt is timestamp;
    }

    match /notificationSubscriptions/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validNotificationSubscription(request.resource.data);
    }
  }
}
